# ==============================================================================
# Hermes Agent - Environment Configuration (.env.example)
# ==============================================================================
# Renomeie este arquivo para `hermes.env` (ou `.env`) e preencha com suas credenciais.
# NUNCA commite o arquivo com os valores reais para o repositório.
# ==============================================================================

# --- LLM Providers & API Keys ---
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# --- Telegram Bot Configuration ---
# Token gerado pelo @BotFather no Telegram
TELEGRAM_BOT_TOKEN=
# Lista de IDs de usuários permitidos separados por vírgula (ex: 123456789,987654321)
TELEGRAM_ALLOWED_USERS=
# ID do canal/chat padrão onde o bot opera
TELEGRAM_HOME_CHANNEL=

# --- GitHub Integration ---
GITHUB_TOKEN=
GH_TOKEN=

# --- LinkedIn Automation ---
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# --- Rocket.Chat Integration ---
ROCKETCHAT_EMAIL=
ROCKETCHAT_PASSWORD=

# --- Audiency Support & Internal Tools ---
SUPORTE_AUDIENCY_EMAIL=
SUPORTE_AUDIENCY_PASSWORD=
SUPORTE_AUDIENCY_URL=https://suporte.audiency.io
SUPORTE_AUDIENCY_API_URL=https://api.audiency.io

# --- Outras Configurações ---
API_SERVER_KEY=
TERMINAL_ENV=
TZ=America/Sao_Paulo
